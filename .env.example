# Sao chép thành `.env` (dev) — dùng chung cho Next.js, script migration và Docker Compose.
# Không commit `.env`. Ở production đặt file này trên server, ngoài repo.
# Mật khẩu chỉ dùng chữ và số (sinh bằng `openssl rand -hex 24`) để khỏi phải URL-encode.

# ---------- App ----------
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=       # bắt buộc khi chạy nhiều bản sao (GĐ sau)

# ---------- MongoDB ----------
MONGODB_DB=quizz
# Next.js/migration chạy trên máy dev kết nối qua cổng 127.0.0.1 (directConnection vì host trong
# replica set là `mongo:27017`, chỉ phân giải được trong mạng Docker).
MONGODB_URI=mongodb://quizz_app:change-me-app@127.0.0.1:27017/quizz?directConnection=true&authSource=quizz

# ---------- Docker Compose ----------
APP_IMAGE=quizz:local                     # prod: ghcr.io/<owner>/quizz:<sha>
APP_DOMAIN=localhost                      # prod: tên miền thật, Caddy tự cấp HTTPS
MONGO_ROOT_USER=root                      # chỉ dùng cho mongo-init, KHÔNG dùng trong app
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USER=quizz_app
MONGO_APP_PASSWORD=change-me-app
MONGO_KEYFILE=./docker/mongo/keyfile      # tạo bằng docker/scripts/gen-keyfile.sh

# ---------- Auth (GĐ 1) ----------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Lưu file S3-compatible (GĐ 2) ----------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---------- Email / SMS (GĐ 1 / GĐ 4) ----------
MAIL_PROVIDER_API_KEY=
MAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
SMS_DAILY_BUDGET=                         # giới hạn chi phí mỗi ngày

# ---------- Chống lạm dụng / giám sát (GĐ 3) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REDIS_URL=
SENTRY_DSN=
